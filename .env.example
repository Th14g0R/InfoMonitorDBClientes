# Copie para .env e preencha. Nunca versionar o .env real.

# Obrigatório: gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

ADMIN_MASTER_EMAIL=
# Usado só na primeira inicialização, se ainda não existir usuário master.
# Depois apague este valor do .env.
ADMIN_MASTER_PASSWORD=

# 1 = permite auto-cadastro público; 0 = só o Master cria contas (recomendado)
ALLOW_PUBLIC_REGISTER=0

# 1 = cookie de sessão só em HTTPS
SESSION_COOKIE_SECURE=0
SESSION_HORAS=8
SENHA_MIN_CHARS=8
TOKEN_RESET_HORAS=1
LOGIN_MAX_TENTATIVAS=8
LOGIN_JANELA_SEGUNDOS=900

# Host de escuta do servidor HTTP:
# - 127.0.0.1 = responde apenas na máquina local (padrão seguro caso BIND_HOST não seja informado)
# - 0.0.0.0 = rede interna (necessário para que outras máquinas acessem o sistema)
BIND_HOST=0.0.0.0
BIND_PORT=8888

# Timeouts SSH (segundos)
TIMEOUT_CONEXAO_SSH=10
TIMEOUT_FIND_ORFAOS=30
# Pool de threads HTTP do Waitress. Mantenha um unico processo para que o
# agendador interno nao execute tarefas duplicadas.
WEB_THREADS=4
# Estado mutavel (SQLite, fotos e logs de servico). Relativo ao projeto ou absoluto.
DATA_DIR=data
MAX_UPLOAD_MB=2048

SERVIDORES_CONFIG={}
# Arquivo OpenSSH known_hosts com as chaves verificadas dos servidores.
# Vazio = arquivo known_hosts na pasta do projeto (ignorado pelo Git).
SSH_KNOWN_HOSTS=
URL_STATUS_BACKUPS_FTP=

# Caminho absoluto para o arquivo da chave mestra AES-GCM (32 bytes em base64 urlsafe)
# NUNCA colocar a chave em si aqui! Apenas o caminho para o arquivo externo protegido por ACL.
BACKUPS_FTP_KEY_PATH=C:\ProgramData\InfoMonitorKeys\backups_ftp.key

# Painel de Agentes do call center (/agentes) - API Beatrix da NPX.
# Token da empresa (cabeçalho Access-token). Sem ele a página mostra um aviso.
NPX_API_TOKEN=
NPX_API_URL=https://app.npxtech.com.br/api
# Painel web da NPX (ações operacionais de agentes: mover, prioridade, pausa, remoção)
NPX_PAINEL_URL=https://app.npx.com.br
NPX_PAINEL_EMAIL=
NPX_PAINEL_SENHA=
# Opcional: apelidos exibidos (padrão: Suporte, Comercial, Financeiro, SPED Fiscal, Ponto, Transbordo)
NPX_FILAS_NOMES=

# Integração PBX da Central Telefônica (/agentes)
# URL base HTTPS da API REST do PBX (aceita apenas HTTPS)
PBX_BASE_URL=
PBX_API_TOKEN=
PBX_API_KEY=
# Verificação TLS da API PBX: true (padrão seguro); defina false apenas para PBX legado com opt-in explícito
PBX_TLS_REJECT_UNAUTHORIZED=true
PBX_MAPA_ARQUIVO=config/analysts_map.json

