# Copie para .env e preencha. Nunca versionar o .env real.

# Obrigatório: gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

ADMIN_MASTER_EMAIL=
# Usado só na primeira inicialização, se ainda não existir usuário master.
# Depois apague este valor do .env.
ADMIN_MASTER_PASSWORD=

# 1 = permite auto-cadastro público; 0 = só o Master cria contas (recomendado)
ALLOW_PUBLIC_REGISTER=0

# 1 = cookie de sessão só em HTTPS
SESSION_COOKIE_SECURE=0
SESSION_HORAS=8
SENHA_MIN_CHARS=8
TOKEN_RESET_HORAS=1
LOGIN_MAX_TENTATIVAS=8
LOGIN_JANELA_SEGUNDOS=900

# 127.0.0.1 = só local; 0.0.0.0 = rede interna
BIND_HOST=127.0.0.1
BIND_PORT=8888
MAX_UPLOAD_MB=2048

# Painel de horários visível sem login (quadro da equipe). 0 = exige login.
PUBLIC_HORARIOS=1

SERVIDORES_CONFIG={}
# Arquivo OpenSSH known_hosts com as chaves verificadas dos servidores.
# Vazio = arquivo known_hosts na pasta do projeto (ignorado pelo Git).
SSH_KNOWN_HOSTS=
URL_STATUS_BACKUPS_FTP=
